resolver 127.0.0.11 valid=10s;

server {
    listen 8080;

    location = /reload {
        return 404;
    }

    location / {
        set $upstream http://audit-svc:8080;
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}

server {
    listen 8081;

    location = /stub_status {
        stub_status;
    }
}